#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

#define UTF_8 "charset=utf-8"

const char* ssid = "Redmi Note 9 Pro";
const char* password = "100500100";
const int servoPins[] = {15, 2, 4};
const int laserPin = 13;
const int buzzerPin = 14;

WebServer server(80);
Servo servos[3];
int initialAngles[] = {95, 70, 95};
bool laserState = false;

void moveServo(int servoIndex, int angle, int delayTime, const char* response) {
  servos[servoIndex].write(angle);
  delay(delayTime);
  servos[servoIndex].write(initialAngles[servoIndex]);
  server.send(200, "text/plain", response);
}

void repeatServoAction(int servoIndex, int angle1, int angle2, int delayTime, int repeatCount, const char* response) {
  for (int i = 0; i < repeatCount; i++) {
    servos[servoIndex].write(angle1);
    delay(delayTime);
    servos[servoIndex].write(angle2);
    delay(delayTime);
  }
  servos[servoIndex].write(initialAngles[servoIndex]);
  server.send(200, "text/plain", response);
}

void toggleLaser() {
  laserState = !laserState;
  digitalWrite(laserPin, laserState ? HIGH : LOW);
  server.send(200, "text/plain", laserState ? "Лазер включен" : "Лазер выключен");
}

void generateBuzzerSound() {
  for (int i = 0; i < 1000; i++) {
    digitalWrite(buzzerPin, HIGH);
    delayMicroseconds(500);
    digitalWrite(buzzerPin, LOW);
    delayMicroseconds(500);
  }
  server.send(200, "text/plain", "Пищалка сработала");
}

void handleRoot() {
  server.send(200, "text/html", R"rawliteral(
    <!DOCTYPE html>
    <html>
    <head>
      <meta charset="utf-8">
      <title>Управление турелью</title>
      <style>
        body { font-family: Arial, sans-serif; text-align: center; padding: 20px; background-color: #f4f4f4; }
        h1 { color: #333; font-size: 2em; }
        button { margin: 10px; padding: 12px 20px; font-size: 18px; cursor: pointer; border: none; border-radius: 5px; background-color: #4285f4; color: white; transition: background-color 0.3s ease; }
        button:hover, button:active, button:focus { background-color: #5277ea; }
         @media (max-width: 1000px) {button {display: block; width: 100%; box-sizing: border-box; height: 70px; margin-bottom: 30px; font-size: 30px;}
      </style>
      <script>
        document.addEventListener('keydown', (event) => {
          const key = event.key.toLowerCase();
          const isShiftPressed = event.shiftKey;

          if (key === 'w' || key === 'ц' || event.key === 'ArrowUp') {
            fetch('/moveUp');
          } else if (key === 's' || key === 'ы' || event.key === 'ArrowDown') {
            fetch('/moveDown');
          } else if (key === 'a' || key === 'ф' || event.key === 'ArrowLeft') {
            fetch('/moveLeft');
          } else if (key === 'd' || key === 'в' || event.key === 'ArrowRight') {
            fetch('/moveRight');
          } else if ((key === 'f' || key === 'а') && isShiftPressed) {
            fetch('/fire');
          } else if (key === 'f' || key === 'а') {
            fetch('/shoot');
          } else if (key === 'l' || key === 'д') {
            fetch('/laser');
          }
        });
      </script>

    </head>
    <body>
      <h1>Управление турелью</h1>
      <button onclick="fetch('/moveLeft')">Влево</button>
      <button onclick="fetch('/moveRight')">Вправо</button>
      <button onclick="fetch('/moveUp')">Вверх</button>
      <button onclick="fetch('/moveDown')">Вниз</button>
      <button onclick="fetch('/fire')">Огонь</button>
      <button onclick="fetch('/shoot')">Выстрел</button>
      <button onclick="fetch('/yes')">ДА</button>
      <button onclick="fetch('/no')">НЕТ</button>
      <button onclick="fetch('/laser')">Лазер</button>
      <button onclick="fetch('/buzzer')">Пищалка</button>
    </body>
    </html>
  )rawliteral");
}

void setup() {
  for (int i = 0; i < 3; i++) {
    servos[i].attach(servoPins[i], 500, 2400);
    servos[i].write(initialAngles[i]);
  }
  pinMode(laserPin, OUTPUT);
  digitalWrite(laserPin, LOW);
  pinMode(buzzerPin, OUTPUT);
  digitalWrite(buzzerPin, LOW);

  WiFi.begin(ssid, password);
  Serial.begin(115200);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.printf("\nWi-Fi подключен: %s\n", WiFi.localIP().toString().c_str());

  server.on("/", handleRoot);
  server.on("/moveLeft", HTTP_GET, []() { moveServo(0, 180, 90, "Сервопривод 1 двигался влево"); });
  server.on("/moveRight", HTTP_GET, []() { moveServo(0, 0, 90, "Сервопривод 1 двигался вправо"); });
  server.on("/moveUp", HTTP_GET, []() {
    initialAngles[1] = max(initialAngles[1] - 10, 35);
    servos[1].write(initialAngles[1]);
    server.send(200, "text/plain", "Сервопривод 2 двигался вверх");
  });
  server.on("/moveDown", HTTP_GET, []() {
    initialAngles[1] = min(initialAngles[1] + 10, 120);
    servos[1].write(initialAngles[1]);
    server.send(200, "text/plain", "Сервопривод 2 двигался вниз");
  });
  server.on("/fire", HTTP_GET, []() { moveServo(2, 0, 660, "Сервопривод 3: Огонь"); });
  server.on("/shoot", HTTP_GET, []() { moveServo(2, 0, 115, "Сервопривод 3: Выстрел"); });
  server.on("/yes", HTTP_GET, []() { repeatServoAction(1, 50, 65, 220, 3, "Сервопривод 2 выполнил ДА"); });
  server.on("/no", HTTP_GET, []() { repeatServoAction(0, 0, 180, 220, 3, "Сервопривод 1 выполнил НЕТ"); });
  server.on("/laser", HTTP_GET, toggleLaser);
  server.on("/buzzer", HTTP_GET, generateBuzzerSound);

  server.begin();
  Serial.println("Сервер запущен");
}

void loop() {
  server.handleClient();
}
